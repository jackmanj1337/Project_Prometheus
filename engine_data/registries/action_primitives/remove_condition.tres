[resource]
script = ExtResource("1")
id = "remove_condition"
family = "action_primitives"
label_key = "registry.action.remove_condition"
owner_feature = "SHARED-EFFECT-CONDITION-LIFECYCLE-2026-08-31"
kind = "mutation"
primitive_handler = "remove_condition"
params_schema = {"condition_id": {"required": false, "type": "string"}}
subjects = Array[String](["actor", "target"])
projection_support = true
