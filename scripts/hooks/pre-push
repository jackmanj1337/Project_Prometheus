#!/usr/bin/env bash
# Versioned pre-push hook (travels with the repo, unlike .git/hooks).
# Activate on each clone with:  git config core.hooksPath scripts/hooks
#
# Destination guard: agents push agent/** branches and v* release tags, nothing
# else. This is the backstop for the merge policy -- a fast-forward merge onto
# main creates no commit, so no commit-time hook sees it; it is caught here.
#
# The destination guard is the safety-critical part. The audit/session-claim/
# evidence checks below came from the release line and now run everywhere, since
# the v0.5.8 promotion brought scripts/ci/ onto the staging line too.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staging_pushes=()
while read -r _local_ref local_sha remote_ref _remote_sha; do
	[[ "$local_sha" == 0000000000000000000000000000000000000000 ]] && continue
	case "$remote_ref" in
		refs/heads/agent/*) ;;
		refs/tags/v[0-9]*) ;;
		*)
			echo "pre-push refuses non-agent destination: $remote_ref" >&2
			echo "  Route it through agent/staging-area and let a human merge that to main." >&2
			exit 1
			;;
	esac
	# Infrastructure goes direct to staging by policy, which is correct -- but a hook
	# or CI check that FEATURE branches execute has to reach the feature base too, or
	# the two lines silently run different code. Checked only on a staging push,
	# because that is the push that creates the gap and can still cheaply close it.
	if [[ "$remote_ref" == "refs/heads/agent/staging-area" ]]; then
		staging_pushes+=("$local_sha")
	fi
done

if [[ ${#staging_pushes[@]} -gt 0 && -f scripts/ci/check_shared_infrastructure_sync.py ]]; then
	for sha in "${staging_pushes[@]}"; do
		echo "pre-push: checking executed infrastructure reaches the feature base..."
		python3 scripts/ci/check_shared_infrastructure_sync.py --pushed "$sha" || exit 1
	done
fi

python3 scripts/ci/audit_cadence.py
python3 scripts/ci/check_session_commit_claims.py || {
	echo "  Fix: python3 scripts/ci/check_session_commit_claims.py --fix" >&2
	echo "  then amend or add a 'Session note:' commit and push again." >&2
	exit 1
}
python3 scripts/ci/check_evidence_matrices.py

# Campaign packs live in sibling repos, so this repo's CI cannot see them and a
# GDScript suite would skip on every CI run. A developer workspace is the one
# place both the engine schema and the packs are visible, which makes pre-push
# the only honest binding point -- and the right moment, since publishing a
# schema change is exactly what silently broke both packs for two weeks.
# Costs ~0.7s per pack; skips loudly where no pack repos are cloned.
if [[ -f scripts/ci/check_pack_freshness.sh ]]; then
	bash scripts/ci/check_pack_freshness.sh || exit 1
fi
