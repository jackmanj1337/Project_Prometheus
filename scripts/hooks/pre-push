#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Destination guard. Agents push agent/** freely; nothing else. This is the
# backstop for the merge policy: a fast-forward merge onto main creates no
# commit, so no commit-time hook sees it — it is caught here instead.
while read -r _local_ref local_sha remote_ref _remote_sha; do
	[[ "$local_sha" == 0000000000000000000000000000000000000000 ]] && continue
	case "$remote_ref" in
		refs/heads/agent/*) ;;
		refs/tags/v[0-9]*) ;;   # release tags are allowed by policy
		*)
			echo "pre-push refuses non-agent destination: $remote_ref" >&2
			echo "  Pushing to '$remote_ref' is a human action; hand off via prepare-manual-pr.sh." >&2
			exit 1
			;;
	esac
done

python3 scripts/ci/audit_cadence.py
python3 scripts/ci/check_session_commit_claims.py
python3 scripts/ci/check_evidence_matrices.py
