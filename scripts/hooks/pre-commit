#!/usr/bin/env bash
# Versioned pre-commit hook (travels with the repo, unlike .git/hooks).
# Activate on each clone with:  git config core.hooksPath scripts/hooks
#   1. Documentation structural checks (DOC-011) — fast, always run.
#   2. RNG-usage guard — blocks new unmarked engine randi() before RngService (M9a).
#   3. Pinned GDScript formatting and lint checks.
#   4. GDScript test suite — only when code/assets changed (skipped for docs-only).
# Set SKIP_TESTS=1 to bypass the test suite (e.g. for WIP commits): SKIP_TESTS=1 git commit ...
cd "$(git rev-parse --show-toplevel)"

# 0. Merge-target guard. When pre-merge-commit rejects a merge, git leaves it
# staged and suggests 'git commit' to finish -- which runs this hook instead.
# Concluding a merge onto a non-agent branch is the same policy violation.
# Not covered by SKIP_TESTS: this is policy, not a test.
if [[ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ]]; then
	merge_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
	case "$merge_branch" in
		agent/*) ;;
		*)
			echo "pre-commit: refusing to conclude a merge on non-agent branch '${merge_branch:-<detached>}'." >&2
			echo "  git merge --abort   # back out, then route via agent/staging-area" >&2
			echo "                      # (prepare-manual-pr.sh writes the hand-off summary)" >&2
			exit 1
			;;
	esac
fi

# 0b. Docs-line guard. Forward-looking PLANS are meant to be visible to everyone
# immediately; a plan committed on an unmerged feature branch strands there (AGENTS.md:
# "A plan on an unmerged branch is invisible to anyone not standing on that branch").
# Keep AGENT/Docs/plans/ on the docs line (agent/integration, agent/staging-area, main).
# Deliberately NARROW: session notes, design/decisions, playtests, GDD, etc. are NOT
# fenced. Session notes are authored with their feature work and reach the docs line
# when the branch merges, which is soon enough for a record of what already happened;
# a plan is different because it describes work not yet done. (This previously cited
# check_session_commit_claims.py as binding notes to the branch's commits. That is no
# longer why: ownership moved out of the notes into AGENT/Session Notes/CLAIMS.tsv, so
# the check binds the LEDGER, not the notes. The fence decision is unchanged; only its
# stated reason was stale.) Logged override: DOCS_GUARD_OVERRIDE=1 git commit ...
guard_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
case "$guard_branch" in
	agent/integration|agent/staging-area|main) ;;  # docs line — plans allowed
	*)
		fenced=()
		while IFS= read -r f; do
			[[ -z "$f" ]] && continue
			case "$f" in
				AGENT/Docs/plans/*) fenced+=("$f") ;;
			esac
		done < <(git diff --cached --name-only --diff-filter=ACMR)
		if [[ ${#fenced[@]} -gt 0 && "${DOCS_GUARD_OVERRIDE:-0}" != "1" ]]; then
			echo "pre-commit: refusing plan docs on feature branch '${guard_branch:-<detached>}':" >&2
			printf '  %s\n' "${fenced[@]}" >&2
			echo "  Plans live on the docs line (agent/integration) so they don't strand on an unmerged branch." >&2
			echo "  Move them there, or override: DOCS_GUARD_OVERRIDE=1 git commit ..." >&2
			exit 1
		elif [[ ${#fenced[@]} -gt 0 ]]; then
			echo "pre-commit: DOCS_GUARD_OVERRIDE=1 — allowing ${#fenced[@]} plan doc(s) on '${guard_branch}'" >&2
		fi
		;;
esac

# 1. Documentation checks — cheap, so gate every commit (this is where DOC-011 runs).
if [[ -f AGENT/Docs/check_docs.py ]] && command -v python3 >/dev/null 2>&1; then
	echo "pre-commit: running documentation checks (check_docs.py)..."
	python3 AGENT/Docs/check_docs.py || exit 1
fi

# 1b. RNG-usage guard — cheap, blocks new unmarked engine randi() before RngService (M9a).
if [[ -f scripts/ci/check_rng_usage.sh ]]; then
	echo "pre-commit: running RNG-usage guard..."
	bash scripts/ci/check_rng_usage.sh || exit 1
fi

# 1b-ii. Gated-entry reason guard — [EPUX-07]/[RPD-15]. A disabled BaseButton must
# carry its reason on the button. Six surfaces got this by hand and nothing ever failed;
# this is the check that makes the seventh fail. Textual, so it costs nothing.
if [[ -f scripts/ci/check_availability_reasons.py ]]; then
	echo "pre-commit: running gated-entry reason guard..."
	python3 scripts/ci/check_availability_reasons.py || exit 1
fi

# 1c. Keep the fast structural/tooling checks aligned with CI. These run before
# the docs-only early exit because scene/parser regressions can come from meta files.
if [[ -f tools/godot-analyzer-mcp/tests/test_tools.py ]]; then
	echo "pre-commit: running analyzer tool tests..."
	python3 tools/godot-analyzer-mcp/tests/test_tools.py || exit 1
fi
if [[ -f scripts/ci/check_scene_integrity.py ]]; then
	echo "pre-commit: running scene-integrity check..."
	python3 scripts/ci/check_scene_integrity.py || exit 1
fi
if [[ -f scripts/ci/check_session_commit_claims.py ]]; then
	echo "pre-commit: checking session-note commit ownership..."
	# A rejection here is nearly always an omission, not a disagreement, and the
	# fix is mechanical — so name the command that performs it. A check that
	# rejects without naming its remedy gets worked around by hand every time.
	python3 scripts/ci/check_session_commit_claims.py || {
		echo "  Fix: python3 scripts/ci/check_session_commit_claims.py --fix" >&2
		exit 1
	}
fi
if [[ -f scripts/ci/check_evidence_matrices.py ]]; then
	echo "pre-commit: checking multi-slice evidence matrices..."
	python3 scripts/ci/check_evidence_matrices.py || exit 1
fi
if [[ -f scripts/ci/check_gdscript_style.sh ]]; then
	echo "pre-commit: checking GDScript formatting and lint..."
	bash scripts/ci/check_gdscript_style.sh || {
		echo "  Fix formatting: bash scripts/ci/check_gdscript_style.sh --fix" >&2
		echo "  (lint findings are not auto-fixable and still need an edit)" >&2
		exit 1
	}
fi

# 2. GDScript test suite.
if [[ "${SKIP_TESTS:-}" == "1" ]]; then
	echo "pre-commit: SKIP_TESTS=1 set — skipping test suite"
	exit 0
fi

# Skip the Godot suite when no runtime files changed. Staged files that are all docs
# (AGENT/, .github/, *.md, *.txt, .gitignore) cannot affect test outcomes; anything
# outside that safelist (a .gd/.tres/.tscn/etc.) triggers the suite. Conservative by
# design — an unrecognized path runs the tests rather than skipping them.
needs_tests=0
while IFS= read -r f; do
	[[ -z "$f" ]] && continue
	case "$f" in
		AGENT/*|.github/*|*.md|*.txt|.gitignore) ;;  # docs/meta — safe to skip
		*) needs_tests=1 ;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ "${needs_tests}" -eq 0 ]]; then
	echo "pre-commit: docs-only change — skipping Godot test suite"
	exit 0
fi

if [[ ! -f run_tests.sh ]]; then
	echo "pre-commit: run_tests.sh not found — skipping"
	exit 0
fi

# Parity with CI (scripts/ci/run_headless_tests.sh): the headless test scripts
# depend on the versioned global class cache. CI regenerates+asserts it; the hook
# only asserts (a full reimport every commit would be too slow). This closes the
# drift where a missing/stale cache failure CI catches but the hook would miss.
if [[ ! -f .godot/global_script_class_cache.cfg ]]; then
	echo "pre-commit: FAIL — .godot/global_script_class_cache.cfg missing."
	echo "  Run 'bash scripts/ci/run_headless_tests.sh' once to regenerate it."
	exit 1
fi

echo "pre-commit: running test suite..."
bash run_tests.sh
exit $?
