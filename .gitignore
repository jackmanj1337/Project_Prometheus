# Godot 4+ specific ignores
# The editor cache directory is generated, including global_script_class_cache.cfg.
# That file used to be tracked so `--script` runs could resolve class_name without
# an import pass, but a tracked copy drifts silently (PrepActivityDef and
# PrepActivityRegistry went missing for weeks) and a *stale* cache is worse than
# none: it fails as `Identifier "X" not declared`, which reads as a code bug.
# Every consumer now regenerates it — scripts/ci/run_headless_tests.sh runs
# `--import` and asserts the file was generated, run_tests.sh warms with
# `--import`, and `--export-release` generates and packs its own copy (verified
# 2026-07-29 by exporting from a checkout with no .godot/ at all).
.godot/*
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local AI agent config (auth/session state)
.claude
.codex

# Local Docker/API-key config
.env

# Python bytecode cache
__pycache__/
*.pyc

# Exported game builds (large binaries; regenerated by the export step).
# Previously ignored only via local .git/info/exclude, so a fresh clone or a
# different machine had no protection against accidentally committing ~100 MB
# debug .exe files. Tracked here so every clone ignores them.
/builds/

# Per-build stamp baked by scripts/prepare_build.sh before export (commit + version +
# timestamp). Regenerated every build; the editor falls back to live git when absent.
/build_info.json

# UI-INSPECTION headless preview harness output (scripts/tools/ui_inspection_preview.gd).
# Review artifacts regenerated on demand — not committed content.
/ui_previews/

# Playtest return packages: keep the evidence (logs, screenshots, checklist,
# resume save) but never the build .zip export artifacts the tester bundles.
**/*playtest results*/*.zip

# Godot import sidecars generated for evidence screenshots in return packages
# (scanned because they live under res://); the PNGs are evidence, not game assets.
**/*playtest results*/*.import
# Suites that failed the last run, consumed by `run_tests.sh --rerun-failed`.
/.test-failures

# Same reason for the zero-content fixture packs: their media is pack content that
# the engine raw-loads (Image.load_from_file -> ImageTexture) per the zero-content
# plan, not a res:// game asset. Godot still scans and imports it because the
# fixtures live under res://, so ignore the generated sidecars rather than track
# an artifact the loader never reads.
/test_fixtures/zero_content/**/*.import
