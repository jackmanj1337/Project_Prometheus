# Godot 4+ specific ignores
# Ignore the editor cache directory's contents, but track the global class
# cache: headless `--script` test runs never regenerate it, so it must be
# versioned for new class_name scripts to resolve on CI / fresh clones.
.godot/*
!.godot/global_script_class_cache.cfg
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local AI agent config (auth/session state)
.claude
.codex

# Local Docker/API-key config
.env

# Python bytecode cache
__pycache__/
*.pyc
