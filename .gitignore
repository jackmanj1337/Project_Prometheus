# Godot 4+ specific ignores
# Ignore the editor cache directory's contents, but track the global class
# cache: headless `--script` test runs never regenerate it, so it must be
# versioned for new class_name scripts to resolve on CI / fresh clones.
.godot/*
!.godot/global_script_class_cache.cfg
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Local AI agent config (auth/session state)
.claude
.codex

# Local Docker/API-key config
.env

# Python bytecode cache
__pycache__/
*.pyc

# Exported game builds (large binaries; regenerated by the export step).
# Previously ignored only via local .git/info/exclude, so a fresh clone or a
# different machine had no protection against accidentally committing ~100 MB
# debug .exe files. Tracked here so every clone ignores them.
/builds/

# Per-build stamp baked by scripts/prepare_build.sh before export (commit + version +
# timestamp). Regenerated every build; the editor falls back to live git when absent.
/build_info.json
