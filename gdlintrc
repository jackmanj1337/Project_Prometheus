# The disabled rules describe intentional legacy architecture or formatter output.
# Keep the remaining correctness/whitespace/naming checks blocking; reduce this
# list in dedicated refactors rather than mixing structural churn into features.
class-definitions-order:
- tools
- classnames
- extends
- docstrings
- signals
- enums
- consts
- staticvars
- exports
- pubvars
- prvvars
- onreadypubvars
- onreadyprvvars
- others
disable:
- class-definitions-order
- duplicated-load
- enum-name
- function-arguments-number
- function-preload-variable-name
- function-variable-name
- load-constant-name
- max-file-lines
- max-line-length
- max-public-methods
- max-returns
- unnecessary-pass
- unused-argument
excluded_directories: !!set
  .git: null
max-line-length: 140
tab-characters: 1
trailing-whitespace: null
