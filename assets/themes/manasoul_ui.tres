; --- Sliders ([UITH-6] first half) -------------------------------------------------
; Eight HSliders on the Settings screen rendered engine-default grey inside these
; ornate panels. The trough and fill are real art; the grabber is a gem from the
; 5-frame emptyFrame strip. State frames are picked by MEASURED luminance rather than
; by eye: frame 3 (amber rim, lum 163) normal, frame 1 (gold rim, lum 208 — the
; brightest in the sheet) hover, frame 4 (lum 109 — the dimmest) disabled.
;
; Defined on HSlider, not Slider: the trough art is sliced horizontally, so a VSlider
; would stretch the gold end caps along the wrong axis. A vertical slider needs its
; own art before it gets a style.
[sub_resource type="StyleBoxTexture" id="SB_slider_track"]
texture = ExtResource("4_bar_track")
texture_margin_left = 12.0
texture_margin_top = 0.0
texture_margin_right = 12.0
texture_margin_bottom = 0.0
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0

[sub_resource type="StyleBoxTexture" id="SB_slider_fill"]
texture = ExtResource("5_bar_fill")
texture_margin_left = 10.0
texture_margin_top = 0.0
texture_margin_right = 10.0
texture_margin_bottom = 0.0

[sub_resource type="AtlasTexture" id="Atlas_gem_normal"]
atlas = ExtResource("6_gem")
region = Rect2(96, 0, 32, 32)

[sub_resource type="AtlasTexture" id="Atlas_gem_hover"]
atlas = ExtResource("6_gem")
region = Rect2(32, 0, 32, 32)

[sub_resource type="AtlasTexture" id="Atlas_gem_disabled"]
atlas = ExtResource("6_gem")
region = Rect2(128, 0, 32, 32)

; --- Scrollbars ---------------------------------------------------------------------
; Flat paint rather than texture, deliberately. The only bar art in the kit is
; horizontal, and a horizontally-sliced texture on a VScrollBar stretches the caps
; along the wrong axis. Colours are taken from the palette already in this file (the
; parchment font colour and the gold focus modulate), so scrollbars read as part of
; the set without inventing directional art.
;
; Defined on ScrollBar, the abstract base: VERIFIED that Godot walks the native class
; chain, so HScrollBar and VScrollBar both resolve these without a second block.
[sub_resource type="StyleBoxFlat" id="SB_scroll_trough"]
bg_color = Color(0.11, 0.09, 0.17, 0.85)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
content_margin_left = 2.0
content_margin_top = 2.0
content_margin_right = 2.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxFlat" id="SB_scroll_focus"]
bg_color = Color(0.11, 0.09, 0.17, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 0.9, 0.75)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_scroll_grabber"]
bg_color = Color(0.55, 0.46, 0.24, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_scroll_grabber_highlight"]
bg_color = Color(0.78, 0.68, 0.38, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_scroll_grabber_pressed"]
bg_color = Color(1, 0.92, 0.62, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

