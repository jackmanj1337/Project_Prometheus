; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fire Emblem RPG"
run/main_scene="res://scenes/core/Boot.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false

[autoload]

GameConstants="*res://scripts/shared/GameConstants.gd"
EventBus="*res://scripts/autoloads/EventBus.gd"
SettingsManager="*res://scripts/autoloads/SettingsManager.gd"
GameState="*res://scripts/autoloads/GameState.gd"
DataManager="*res://scripts/autoloads/DataManager.gd"
ConditionManager="*res://scripts/autoloads/ConditionManager.gd"
SkillHandler="*res://scripts/skills/SkillHandler.gd"
ItemHandler="*res://scripts/items/ItemHandler.gd"
CombatResolver="*res://scripts/core/CombatResolver.gd"
EnemyAI="*res://scripts/core/EnemyAI.gd"
PairUpRegistry="*res://scripts/autoloads/PairUpRegistry.gd"
PairUpBonusResolver="*res://scripts/autoloads/PairUpBonusResolver.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

